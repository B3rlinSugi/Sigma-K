// SIGMA-K PostgreSQL Database Schema (Prisma ORM)
// Source of Truth: docs/data/08_TARGET_POSTGRESQL_MODEL.md, docs/data/09_ERD.md, docs/backend/09_DATABASE_MAPPING.md
// Phase: 5B Implementation (Development Database)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. MASTER DATA: REGION & INSTITUTION TYPES
// ==========================================

model InstitutionType {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(50) // KEMENKO, KEMENTERIAN, LPNK, LNS, PEMPROV, PEMKAB, PEMKOT
  name         String        @db.VarChar(100)
  level        String        @db.VarChar(20) // PUSAT, DAERAH
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  institutions Institution[]

  @@map("institution_types")
}

model Region {
  id           String        @id @db.VarChar(10) // Kemendagri Code e.g. "31", "31.71"
  code         String        @unique @db.VarChar(20)
  name         String        @db.VarChar(150)
  level        String        @db.VarChar(20) // PROVINSI, KABUPATEN, KOTA
  parentId     String?       @map("parent_id") @db.VarChar(10)
  parent       Region?       @relation("RegionHierarchy", fields: [parentId], references: [id])
  children     Region[]      @relation("RegionHierarchy")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  institutions Institution[]

  @@index([parentId], name: "idx_reg_parent_id")
  @@map("regions")
}

// ==========================================
// 2. INSTITUTIONS & PROFILES
// ==========================================

model Institution {
  id                     String                 @id @default(uuid()) @db.Uuid
  code                   String                 @unique @db.VarChar(50) // e.g. "KL-042"
  name                   String                 @db.VarChar(255)
  shortName              String                 @map("short_name") @db.VarChar(100)
  typeId                 Int                    @map("type_id")
  type                   InstitutionType        @relation(fields: [typeId], references: [id])
  regionId               String?                @map("region_id") @db.VarChar(10)
  region                 Region?                @relation(fields: [regionId], references: [id])
  status                 String                 @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, DISSOLVED
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  
  profile                InstitutionProfile?
  organizationUnits      OrganizationUnit[]
  tupoksiItems           TupoksiItem[]
  cabinetMemberships     CabinetMembership[]
  predecessorLineages    InstitutionLineage[]   @relation("PredecessorLineages")
  successorLineages      InstitutionLineage[]   @relation("SuccessorLineages")
  submissionTickets      SubmissionTicket[]
  users                  User[]
  userInstitutionScopes  UserInstitutionScope[]

  @@index([typeId], name: "idx_inst_type_id")
  @@index([status], name: "idx_inst_status")
  @@map("institutions")
}

model InstitutionProfile {
  id                     String      @id @default(uuid()) @db.Uuid
  institutionId          String      @unique @map("institution_id") @db.Uuid
  institution            Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  legalBasisNumber       String?     @map("legal_basis_number") @db.VarChar(150)
  legalBasisDate         DateTime?   @map("legal_basis_date") @db.Date
  legalDocFileId         String?     @map("legal_doc_file_id") @db.Uuid
  address                String?     @db.Text
  city                   String?     @db.VarChar(100)
  postalCode             String?     @map("postal_code") @db.VarChar(10)
  phone                  String?     @db.VarChar(50)
  email                  String?     @db.VarChar(100)
  website                String?     @db.VarChar(255)
  logoUrl                String?     @map("logo_url") @db.VarChar(500)
  customAttributes       Json?       @map("custom_attributes") // JSONB
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  @@map("institution_profiles")
}

// ==========================================
// 3. CABINETS & LINEAGE
// ==========================================

model Cabinet {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(150) // e.g. "Kabinet Merah Putih"
  presidentName  String          @map("president_name") @db.VarChar(150)
  vicePresident  String          @map("vice_president_name") @db.VarChar(150)
  description    String?         @db.Text
  isActive       Boolean         @default(false) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  periods        CabinetPeriod[]

  @@map("cabinets")
}

model CabinetPeriod {
  id                 String              @id @default(uuid()) @db.Uuid
  cabinetId          String              @map("cabinet_id") @db.Uuid
  cabinet            Cabinet             @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime?           @map("end_date") @db.Date
  legalDecreeNumber  String              @map("legal_decree_number") @db.VarChar(150)
  status             String              @default("ACTIVE") @db.VarChar(20) // ACTIVE, CONCLUDED
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  memberships        CabinetMembership[]
  lineages           InstitutionLineage[]

  @@index([cabinetId], name: "idx_cab_per_cabinet_id")
  @@map("cabinet_periods")
}

model CabinetMembership {
  id              String        @id @default(uuid()) @db.Uuid
  cabinetPeriodId String        @map("cabinet_period_id") @db.Uuid
  cabinetPeriod   CabinetPeriod @relation(fields: [cabinetPeriodId], references: [id], onDelete: Cascade)
  institutionId   String        @map("institution_id") @db.Uuid
  institution     Institution   @relation(fields: [institutionId], references: [id])
  category        String        @db.VarChar(30) // KEMENKO, TEKNIS, LPNK, LNS
  joinedDate      DateTime      @map("joined_date") @db.Date
  endedDate       DateTime?     @map("ended_date") @db.Date
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([cabinetPeriodId, institutionId], name: "uq_cab_mem_period_inst")
  @@map("cabinet_memberships")
}

model InstitutionLineage {
  id              String        @id @default(uuid()) @db.Uuid
  cabinetPeriodId String        @map("cabinet_period_id") @db.Uuid
  cabinetPeriod   CabinetPeriod @relation(fields: [cabinetPeriodId], references: [id])
  predecessorId   String?       @map("predecessor_id") @db.Uuid
  predecessor     Institution?  @relation("PredecessorLineages", fields: [predecessorId], references: [id])
  successorId     String        @map("successor_id") @db.Uuid
  successor       Institution   @relation("SuccessorLineages", fields: [successorId], references: [id])
  transitionType  String        @map("transition_type") @db.VarChar(30) // NEW, SPLIT, MERGE, RENAME, DISSOLVED, UNCHANGED
  notes           String?       @db.Text
  effectiveDate   DateTime      @map("effective_date") @db.Date
  legalDecreeRef  String?       @map("legal_decree_ref") @db.VarChar(150)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([predecessorId, successorId], name: "idx_lin_pred_succ")
  @@map("institution_lineage")
}

// ==========================================
// 4. ORGANIZATION UNITS & ECHELONS
// ==========================================

model EchelonLevel {
  id                Int                @id @default(autoincrement())
  code              String             @unique @db.VarChar(20) // I.a, I.b, II.a, II.b, NON_ESELON
  name              String             @db.VarChar(100)
  rankOrder         Int                @map("rank_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  organizationUnits OrganizationUnit[]

  @@map("echelon_levels")
}

model OrganizationUnit {
  id             String             @id @default(uuid()) @db.Uuid
  institutionId  String             @map("institution_id") @db.Uuid
  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentId       String?            @map("parent_id") @db.Uuid
  parent         OrganizationUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id])
  children       OrganizationUnit[] @relation("UnitHierarchy")
  unitCode       String             @map("unit_code") @db.VarChar(50)
  unitName       String             @map("unit_name") @db.VarChar(255)
  echelonId      Int?               @map("echelon_id")
  echelon        EchelonLevel?      @relation(fields: [echelonId], references: [id])
  hierarchyLevel Int                @default(1) @map("hierarchy_level")
  sortOrder      Int                @default(0) @map("sort_order")
  isActive       Boolean            @default(true) @map("is_active")
  leaderTitle    String?            @map("leader_title") @db.VarChar(150)
  leaderName     String?            @map("leader_name") @db.VarChar(150)
  staffCount     Int                @default(0) @map("staff_count")
  tupoksiCount   Int                @default(0) @map("tupoksi_count")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  tupoksiItems   TupoksiItem[]

  @@index([institutionId], name: "idx_org_institution_id")
  @@index([parentId], name: "idx_org_parent_id")
  @@index([unitCode], name: "idx_org_unit_code")
  @@map("organization_units")
}

// ==========================================
// 5. TUPOKSI (TUGAS & FUNGSI)
// ==========================================

model TupoksiItem {
  id                    String            @id @default(uuid()) @db.Uuid
  institutionId         String            @map("institution_id") @db.Uuid
  institution           Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  organizationUnitId    String?           @map("organization_unit_id") @db.Uuid
  organizationUnit      OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  type                  String            @db.VarChar(20) // DUTY, FUNCTION
  contentText           String            @map("content_text") @db.Text
  legalArticleReference String?           @map("legal_article_reference") @db.VarChar(150)
  sequenceNumber        Int               @default(1) @map("sequence_number")
  version               String            @default("1.0") @db.VarChar(20)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([institutionId, type], name: "idx_tup_inst_type")
  @@index([organizationUnitId], name: "idx_tup_org_unit")
  @@map("tupoksi_items")
}

// ==========================================
// 6. USERS, ROLES & SCOPES
// ==========================================

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50) // USER, VERIFIKATOR, ADMIN, SESDEP
  description String?    @db.VarChar(255)
  permissions String[]   @default([])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("roles")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  username              String                 @unique @db.VarChar(100)
  email                 String                 @unique @db.VarChar(150)
  passwordHash          String                 @map("password_hash") @db.VarChar(255)
  fullName              String                 @map("full_name") @db.VarChar(150)
  nip                   String?                @unique @db.VarChar(30)
  institutionId         String?                @map("institution_id") @db.Uuid
  institution           Institution?           @relation(fields: [institutionId], references: [id])
  avatarUrl             String?                @map("avatar_url") @db.VarChar(500)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  
  userRoles             UserRole[]
  userInstitutionScopes UserInstitutionScope[]
  submittedTickets      SubmissionTicket[]     @relation("SubmittedByUser")
  approvedTickets       SubmissionTicket[]     @relation("ApprovedByUser")
  verificationLogs      VerificationLog[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("users")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    Int      @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId], name: "uq_user_role")
  @@map("user_roles")
}

model UserInstitutionScope {
  id            Int         @id @default(autoincrement())
  userId        String      @map("user_id") @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String      @map("institution_id") @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions   String[]    @default([])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([userId, institutionId], name: "uq_user_institution_scope")
  @@map("user_institution_scopes")
}

// ==========================================
// 7. WORKFLOWS, SUBMISSIONS & VERIFICATIONS
// ==========================================

model SubmissionTicket {
  id                 String               @id @default(uuid()) @db.Uuid
  ticketNumber       String               @unique @map("ticket_number") @db.VarChar(50) // TKT-YYYYMMDD-XXXX
  institutionId      String               @map("institution_id") @db.Uuid
  institution        Institution          @relation(fields: [institutionId], references: [id])
  submissionType     String               @map("submission_type") @db.VarChar(50) // STRUKTUR_ORGANISASI, TUPOKSI, etc.
  title              String               @db.VarChar(255)
  submissionNotes    String?              @map("submission_notes") @db.Text
  legalDocPath       String?              @map("legal_doc_path") @db.VarChar(500)
  legalDocName       String?              @map("legal_doc_name") @db.VarChar(255)
  status             String               @default("DRAFT") @db.VarChar(30) // DRAFT, SUBMITTED, IN_REVIEW, REVISION_REQUIRED, RESUBMITTED, VERIFIED, APPROVED, REJECTED
  priority           String               @default("NORMAL") @db.VarChar(20)
  submitterUserId    String               @map("submitter_user_id") @db.Uuid
  submitterUser      User                 @relation("SubmittedByUser", fields: [submitterUserId], references: [id])
  approvedByUserId   String?              @map("approved_by_user_id") @db.Uuid
  approvedByUser     User?                @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  submittedAt        DateTime?            @map("submitted_at")
  approvedAt         DateTime?            @map("approved_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  
  items              SubmissionItem[]
  revisions          SubmissionRevision[]
  verificationLogs   VerificationLog[]

  @@index([institutionId], name: "idx_sub_inst_id")
  @@index([status], name: "idx_sub_status")
  @@map("submission_tickets")
}

model SubmissionItem {
  id                 String           @id @default(uuid()) @db.Uuid
  submissionTicketId String           @map("submission_ticket_id") @db.Uuid
  submissionTicket   SubmissionTicket @relation(fields: [submissionTicketId], references: [id], onDelete: Cascade)
  targetEntityType   String           @map("target_entity_type") @db.VarChar(50) // ORGANIZATION_UNIT, TUPOKSI, INSTITUTION_PROFILE
  targetEntityId     String?          @map("target_entity_id") @db.Uuid
  actionType         String           @map("action_type") @db.VarChar(20) // CREATE, UPDATE, DELETE
  fieldName          String?          @map("field_name") @db.VarChar(100)
  label              String           @db.VarChar(255)
  payloadBefore      Json?            @map("payload_before") // JSONB
  payloadAfter       Json?            @map("payload_after")  // JSONB
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([submissionTicketId], name: "idx_sub_item_ticket_id")
  @@map("submission_items")
}

model SubmissionRevision {
  id                 String           @id @default(uuid()) @db.Uuid
  submissionTicketId String           @map("submission_ticket_id") @db.Uuid
  submissionTicket   SubmissionTicket @relation(fields: [submissionTicketId], references: [id], onDelete: Cascade)
  revisionNumber     Int              @default(1) @map("revision_number")
  verifierNotes      String           @map("verifier_notes") @db.Text
  operatorResponse   String?          @map("operator_response") @db.Text
  revisedPayload     Json?            @map("revised_payload") // JSONB
  submittedAt        DateTime         @default(now()) @map("submitted_at")
  revisedAt          DateTime?        @map("revised_at")

  @@index([submissionTicketId], name: "idx_sub_rev_ticket_id")
  @@map("submission_revisions")
}

model VerificationLog {
  id                 String           @id @default(uuid()) @db.Uuid
  submissionTicketId String           @map("submission_ticket_id") @db.Uuid
  submissionTicket   SubmissionTicket @relation(fields: [submissionTicketId], references: [id], onDelete: Cascade)
  verifierUserId     String           @map("verifier_user_id") @db.Uuid
  verifierUser       User             @relation(fields: [verifierUserId], references: [id])
  decision           String           @db.VarChar(30) // PASS, REVISION_REQUIRED, REJECT
  notes              String           @db.Text
  verifiedAt         DateTime         @default(now()) @map("verified_at")

  @@index([submissionTicketId], name: "idx_ver_log_ticket_id")
  @@map("verification_logs")
}

// ==========================================
// 8. NOTIFICATIONS & AUDIT LOGS
// ==========================================

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(255)
  message    String   @db.Text
  category   String   @db.VarChar(50) // WORKFLOW, MASTER_DATA, SECURITY, SYSTEM
  actionUrl  String?  @map("action_url") @db.VarChar(255)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, isRead], name: "idx_notif_user_read")
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName    String   @map("actor_name") @db.VarChar(150)
  actorRole    String   @map("actor_role") @db.VarChar(50)
  action       String   @db.VarChar(50) // CREATE, UPDATE, DELETE, SUBMIT, VERIFY, APPROVE, REJECT
  entityType   String   @map("entity_type") @db.VarChar(50) // INSTITUTION, ORGANIZATION_UNIT, SUBMISSION_TICKET, etc.
  entityId     String   @map("entity_id") @db.VarChar(100)
  entityName   String?  @map("entity_name") @db.VarChar(255)
  oldValues    Json?    @map("old_values") // JSONB
  newValues    Json?    @map("new_values") // JSONB
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], name: "idx_aud_entity")
  @@index([action], name: "idx_aud_action")
  @@index([createdAt], name: "idx_aud_created_at")
  @@map("audit_logs")
}
