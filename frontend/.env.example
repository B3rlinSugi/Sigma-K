# ==============================================================================
# SIGMA-K FRONTEND ENVIRONMENT CONFIGURATION (Next.js 14)
# ==============================================================================

# API Base URL pointing to the CodeIgniter 4 backend
# In local development: http://localhost:8080/api/v1
# In production: https://api.eskld.menpan.go.id/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Transport Mode:
# 'mock' = Run on simulated in-memory mock datasets (Default for standalone UI demo)
# 'api'  = Connect live to CodeIgniter 4 + MySQL backend
NEXT_PUBLIC_DATA_MODE=mock

# HTTP Request Timeout in milliseconds
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=15000
